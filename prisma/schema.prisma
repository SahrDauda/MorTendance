generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id                 String              @id @default(uuid())
  name               String              @unique
  headId             String?             @unique @map("head_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  attendanceSessions AttendanceSession[]
  head               User?               @relation("BranchHead", fields: [headId], references: [id])
  cbsLocations       CBSLocation[]
  members            Member[]
  groups             MinistryGroup[]

  @@map("branches")
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  name             String
  passwordHash     String              @map("password_hash")
  role             UserRole            @default(PROBATION_LEADER)
  passwordUpdated  Boolean             @default(false) @map("password_updated")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  recordedSessions AttendanceSession[] @relation("SessionRecorder")
  completedSessions AttendanceSession[] @relation("SessionCompleter")
  auditLogs        AuditLog[]
  managedBranch    Branch?             @relation("BranchHead")
  managedCBS       CBSLocation[]       @relation("CBSLeader")
  managedGroups    MinistryGroup[]     @relation("GroupLeader")

  @@map("users")
}

model MinistryGroup {
  id                 String              @id @default(uuid())
  name               String              @unique
  leaderId           String?             @map("leader_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  branchId           String?             @map("branch_id")
  attendanceSessions AttendanceSession[]
  members            Member[]
  branch             Branch?             @relation(fields: [branchId], references: [id])
  leader             User?               @relation("GroupLeader", fields: [leaderId], references: [id])

  @@map("ministry_groups")
}

model CBSLocation {
  id                 String              @id @default(uuid())
  name               String
  address            String?
  district           String?
  branchId           String              @map("branch_id")
  leaderId           String?             @map("leader_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  attendanceSessions AttendanceSession[]
  branch             Branch              @relation(fields: [branchId], references: [id])
  leader             User?               @relation("CBSLeader", fields: [leaderId], references: [id])

  @@map("cbs_locations")
}

model Member {
  id                String             @id @default(uuid())
  name              String
  phoneNumber       String?            @map("phone_number")
  address           String?
  gender            Gender?
  schoolName        String?            @map("school_name")
  groupId           String?            @map("group_id")
  branchId          String             @map("branch_id")
  status            MemberStatus       @default(PRELIMINARY)
  joinedAt          DateTime           @default(now()) @map("joined_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  attendanceRecords AttendanceRecord[]
  branch            Branch             @relation(fields: [branchId], references: [id])
  group             MinistryGroup?     @relation(fields: [groupId], references: [id])

  @@map("members")
}

model AttendanceSession {
  id            String             @id @default(uuid())
  type          EventType
  date          DateTime           @db.Date
  branchId      String             @map("branch_id")
  recorderId    String             @map("recorder_id")
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at")
  groupId       String?            @map("group_id")
  cbsLocationId String?            @map("cbs_location_id")
  cutoffTime    String?            @map("cutoff_time")
  isActive      Boolean            @default(true) @map("is_active")
  status        AttendanceSessionStatus @default(DRAFT)
  completedAt   DateTime?          @map("completed_at")
  completedById String?            @map("completed_by_id")
  records       AttendanceRecord[]
  branch        Branch             @relation(fields: [branchId], references: [id])
  cbsLocation   CBSLocation?       @relation(fields: [cbsLocationId], references: [id])
  group         MinistryGroup?     @relation(fields: [groupId], references: [id])
  recorder      User               @relation("SessionRecorder", fields: [recorderId], references: [id])
  completedBy   User?              @relation("SessionCompleter", fields: [completedById], references: [id])

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String            @map("session_id")
  memberId  String            @map("member_id")
  isPresent Boolean           @default(false) @map("is_present")
  notes     String?
  createdAt DateTime          @default(now()) @map("created_at")
  isLate    Boolean           @default(false) @map("is_late")
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@map("attendance_records")
}

model AIInsight {
  id        String   @id @default(uuid())
  type      String
  content   String
  targetId  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_insights")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum AttendanceSessionStatus {
  DRAFT
  COMPLETED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  BRANCH_HEAD
  COORDINATOR
  SENIOR_LEADER
  JUNIOR_LEADER
  PROBATION_LEADER
}

enum MemberStatus {
  LEADER
  INTENSE
  CONSISTENT
  SEMI_CONSISTENT
  INCONSISTENT
  FIRST_TIMER
  PRELIMINARY
  ESTABLISHED
}

enum EventType {
  SATURDAY_FELLOWSHIP
  LEADERSHIP_MEETING
  CBS
  EVANGELISM
  SCHOOL_VISIT
}

enum Gender {
  MALE
  FEMALE
}

// ==========================================
// MOR CAMP SPECIFIC TABLES (ISOLATED SCHEMA)
// ==========================================

model CampMember {
  id             String           @id @default(uuid())
  badgeId        String           @unique @map("badge_id")
  fullName       String           @map("full_name")
  phone          String?
  gender         String           @default("Male")
  branch         String?
  caregroup      String?
  room           String?
  position       String           @default("General Member")
  goingOut       Boolean          @default(false) @map("going_out")
  paid           Boolean          @default(false)
  paidAmount     Float?           @default(0) @map("paid_amount")
  paymentClaimed Boolean          @default(false) @map("payment_claimed")
  couponNum      Int              @default(0) @map("coupon_num")
  foodReceived   Boolean          @default(false) @map("food_received")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  attendances    CampAttendance[]

  @@map("camp_members")
}

model CampGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  leader    String?
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("camp_groups")
}

model CampBranch {
  id          String   @id @default(uuid())
  name        String   @unique
  district    String?
  coordinator String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("camp_branches")
}

model CampRoom {
  id        String   @id @default(uuid())
  name      String   @unique
  gender    String   @default("Male")
  capacity  Int      @default(30)
  leader    String?
  assistant String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("camp_rooms")
}

model CampAttendance {
  id         String     @id @default(uuid())
  memberId   String     @map("member_id")
  session    String
  isPresent  Boolean    @default(true) @map("is_present")
  isLate     Boolean    @default(false) @map("is_late")
  scannedAt  DateTime   @default(now()) @map("scanned_at")
  recordedBy String?    @map("recorded_by")
  member     CampMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, session])
  @@map("camp_attendances")
}

model CampSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("camp_settings")
}
